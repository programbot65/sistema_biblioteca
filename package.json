{
  "name": "biblioteca-ueea",
  "version": "1.0.0",
  "description": "Sistema web para la gestión de recursos bibliográficos de la biblioteca de la UEEA",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrar.js",
    "db:seed": "node scripts/semilla.js",
    "db:reset": "node scripts/reiniciar.js",
    "db:respaldo": "node scripts/respaldo.js",
    "revisar:interfaz": "node scripts/revisar-interfaz.js",
    "revisar:geometria": "node scripts/revisar-geometria.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "biblioteca",
    "catalogo",
    "prestamos",
    "express",
    "sqlite"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
